{
  "expo": {
    "name": "iTalya",
    "slug": "italya",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "italya",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amooott.italya",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDisplayName": "iTalya",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "platforms": [
      "ios"
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
